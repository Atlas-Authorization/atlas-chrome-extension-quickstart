{
  "manifest_version": 3,
  "name": "Atlas Extension Quickstart",
  "version": "0.1.0",
  "description": "A minimal MV3 extension authenticated with Atlas.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://atlasauth.net/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atlas Quickstart"
  }
}
