{
  "name": "atlas-chrome-extension-quickstart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MV3 Chrome extension wired to Atlas auth with @atlasauth/chrome-extension.",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/background.ts src/popup.ts --bundle --format=esm --outdir=dist",
    "watch": "esbuild src/background.ts src/popup.ts --bundle --format=esm --outdir=dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlasauth/chrome-extension": "^0.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
